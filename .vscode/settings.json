{
  "chat.useAgentsMdFile": true,
  // 커밋 입력을 에디터(COMMIT_EDITMSG)로 연다 — git이 commit.template
  // (.gitmessage.txt)을 그대로 채워 템플릿 안내가 전부 보인다. SCM 입력창은
  // 주석(#)뿐인 이 템플릿을 표시하지 못한다.
  "git.useEditorAsCommitInput": true,
  "git.verboseCommit": true
  // github.copilot.chat.commitMessageGeneration.instructions는 뺐다 — 값이
  // 비어 있지 않으면 Copilot 커밋 메시지 생성이 422(promptFiltered)로 조용히
  // 실패한다(microsoft/vscode#315997, 2026-08-15 기준 미해결). 커밋 형식
  // 지침은 AGENTS.md의 Commit messages 절이 이미 담고 있다. 이슈가 닫히면
  // 아래를 복원한다:
  // "github.copilot.chat.commitMessageGeneration.instructions": [
  //   { "file": ".gitmessage.txt" },
  //   { "text": "커밋 메시지의 주제와 본문은 반드시 한국어로 작성한다. 형식은 <타입>(<영역>): <주제>이며, 타입은 .gitmessage.txt 목록의 영어 소문자 키워드(feat, fix, docs 등)를 사용한다. 주제는 50자 이내·현재형·마침표 금지로 쓰고, 본문은 한 줄 72자 이내로 왜 변경했는지 설명한다." }
  // ]
}
